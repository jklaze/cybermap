# Copy this file to .env and fill in the values.

# Required: get a free key at https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# Required: get a free token at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Optional: coordinates of your HQ (used as the arc destination)
HQ_IP=8.8.8.8
HQ_LAT=37.3845
HQ_LNG=-122.0881

# Optional: demo traffic rate (events per second)
EVENT_RATE=5

# Optional: host port for the web UI (default 8888)
ATTACK_MAP_PORT=8888

# Optional: how many days before re-downloading the GeoIP DB (default 14)
GEOIP_MAX_AGE_DAYS=14

# Set to false to stop the synthetic event generator. The container is still
# created so you can flip it back on later without rebuilding.
SYSLOG_GEN_ENABLED=true

# To feed REAL host logs, copy docker-compose.override.example.yml to
# docker-compose.override.yml and add one read-only directory mount per log
# source (see "Feeding real logs" in the README). Then list the files to
# tail below (comma-separated container paths under /host-logs/...).
# Takes precedence over SYSLOG_PATH.
# SYSLOG_PATHS=/host-logs/system/auth.log,/host-logs/system/ufw.log

# Optional: override the single path data-server reads inside the container.
# Defaults to /var/log/attack-map/syslog (the syslog-gen output).
# SYSLOG_PATH=/var/log/attack-map/syslog

# Optional: point data-server at your own parser rules. Defaults to the
# bundled DataServer/parsers.yml (demo CSV format). Must be an absolute
# host path to a YAML file with the schema documented in parsers.yml.
# HOST_PARSERS_PATH=/etc/cybermap/parsers.yml
