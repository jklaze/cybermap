# Copy this file to .env and fill in the values.

# Required: get a free key at https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# Required: get a free token at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Optional: coordinates of your HQ (used as the arc destination)
HQ_IP=8.8.8.8
HQ_LAT=37.3845
HQ_LNG=-122.0881

# Optional: demo traffic rate (events per second)
EVENT_RATE=5

# Optional: host port for the web UI (default 8888)
ATTACK_MAP_PORT=8888

# Optional: how many days before re-downloading the GeoIP DB (default 14)
GEOIP_MAX_AGE_DAYS=14
